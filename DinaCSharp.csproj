<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Authors>LACOMBE Dominique</Authors>
        <AnalysisLevel>latest-all</AnalysisLevel>
        <Title>DinaCSharp</Title>
        <Description>DinaCSharp est un framework développé par LACOMBE Dominique et réalisé à partir de MonoGame.</Description>
        <NeutralLanguage>fr-FR</NeutralLanguage>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <Nullable>enable</Nullable>
        <MinVerTagPrefix>v</MinVerTagPrefix>
        <Copyright>Copyright (c) 2022-2026 LACOMBE Dominique</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://dinacsharp.lacombedominique.com/</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Asthegor/DinaCSharp.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>monogame;csharp;game</PackageTags>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DebugType>none</DebugType>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <DebugType>none</DebugType>
    </PropertyGroup>
    <ItemGroup>
        <None Remove=".config\**" />
        <None Remove="Documentation\**" />
        <None Remove="Documentation.xml" />
        <None Remove="Resources\CircleMask.png" />
        <None Remove="Resources\DropDownArrow.png" />
        <None Remove="Resources\Logo.png" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Resources\CircleMask.png" />
        <EmbeddedResource Include="Resources\DropDownArrow.png" />
        <EmbeddedResource Include="Resources\Logo.png" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5" />
        <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="all" />
    </ItemGroup>
    <ItemGroup>
        <Compile Update="Messages\Messages.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Messages.resx</DependentUpon>
        </Compile>
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Update="Messages\Messages.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Messages.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>
    <ItemGroup>
        <None Update="DLACrypto.dll">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <Pack>true</Pack>
            <PackagePath>runtimes/win-x64/native/</PackagePath>
        </None>
        <None Update="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
